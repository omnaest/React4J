<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.omnaest.react</groupId>
        <artifactId>react4j-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>react4j-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsUtils</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsTable</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsRESTClient</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsMarkdown</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsTemplate</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsTest</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- CommonsTest wires junit-jupiter-engine directly (not the junit-jupiter aggregator), so params is not
                 transitive; needed for @ParameterizedTest in NodeRendererCompletenessMetaTest (plan-74 Goal-4 C4 meta-test). -->
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.2.3</version>
            <scope>test</scope>
            <exclusions>
                <!-- the project already provides its Slf4j binding via log4j-slf4j2-impl (see CommonsLog); spring-boot-starter-logging
                     pulls in log4j-to-slf4j, and Log4j2 refuses to initialize when both bridges are on the classpath at once. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- test-only: a Form's DataContext requires a RepositoryProvider bean (see ContextFactoryImpl); this supplies
                 the zero-config in-memory one via @EnableReactUIInMemoryRepository for FileUploadEndToEndTest. No circular
                 dependency: react4j-data-inmemory depends only on react4j-data (already a compile dependency here), not on react4j-core. -->
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-data-inmemory</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- test-only: this module deliberately depends on spring-web/spring-webmvc rather than the full
                 spring-boot-starter-web, so it never pulls jackson-datatype-jdk8 (normally supplied transitively by
                 spring-boot-starter-json in a real consuming app). FileUploadEndToEndTest's minimal @SpringBootApplication
                 needs it directly to serialize NodeHierarchy's Optional<UIContextDataNode> field. The version used to be
                 pinned here to match the jackson-core/jackson-databind on this module's classpath; both are now managed
                 by the jackson-bom imported in CommonsParent, which keeps them in step automatically. -->
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-core-markdown</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-core-content</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-core-components</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-data</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-i18n</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.omnaest.react</groupId>
            <artifactId>react4j-core-ui</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

</project>