<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.omnaest.react</groupId>
        <artifactId>react4j-app-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>react4j-ui-test</artifactId>

    <!-- plan-74 Cliff C5: Tier-2 browser *IT tests are excluded from default `mvn test` via this
         POM property (NOT a surefire/failsafe configuration literal: such a literal always wins
         over a same-named -D override and would silently kill the on-demand path; see memory
         surefire-excludedgroups-property-not-config-literal). Both surefire (default-test,
         phase test) and failsafe (integration-test/verify) read ${excludedGroups} by default, so
         one property gates both. Run on demand with -DexcludedGroups= (clears it) or
         -Dgroups=browser. -->
    <properties>
        <excludedGroups>browser</excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.omnaest.utils</groupId>
            <artifactId>CommonsTest</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.2.3</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <!-- Workspace JUnit pin sweep (infrastructure-operator): same fix as react4j-core's pom.xml -
                     this module also parents CommonsParent directly, so CommonsParent's junit-bom import
                     (5.14.4) forces spring-boot-starter-test:3.2.3's own literal junit-jupiter aggregator
                     pin (5.10.2) up to 5.14.4, an artifact never downloaded to this offline workspace's
                     .m2 (only junit-jupiter-api/-engine/-params 5.14.4 were cached), failing dependency
                     resolution outright. CommonsTest already supplies the full JUnit 5 stack, so the
                     aggregator is never actually needed. -->
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- plan-235 S3 (browser verification). react4j-data-datagrid -> CommonsDataGrid -> Apache Ignite ->
                 Calcite -> Avatica pulls httpclient5:5.2.3, which depends on httpcore5-h2 but NOT on plain
                 httpcore5 - so org.apache.hc.core5.io.ModalCloseable (declared in the PLAIN httpcore5 artifact,
                 confirmed present in the cached 5.2.5 jar; httpcore5-h2 does not carry it) was simply absent from
                 the classpath. Spring's own HttpComponentsClientHttpRequestFactory (used by
                 TestRestTemplateContextCustomizer, which every @SpringBootTest with a real web environment
                 constructs) references that class directly, so EVERY such test failed at ApplicationContext
                 startup with NoClassDefFoundError before any test method ran - reproduced on the unmodified,
                 pre-existing ToggleButtonRoundTripIT too, so this is a pre-existing environment gap, not caused by
                 this slice's own change. Declaring the already-cached plain httpcore5 explicitly (same version as
                 the resolved httpcore5-h2) puts ModalCloseable back on the classpath without touching the
                 Ignite/Calcite/Avatica chain's own real dependency on httpclient5. Deliberately NOT
                 test-scoped: `mvn verify`'s spring-boot:process-aot goal (bound by the inherited Spring Boot
                 plugin configuration, unrelated to this slice) forks a SEPARATE process resolving against the
                 compile/runtime classpath, not the test one, and hit the identical NoClassDefFoundError
                 (org.apache.hc.core5.http.ClassicHttpRequest this time, same missing-plain-httpcore5 gap) until
                 this was widened off test scope. httpclient5 itself already reaches MockApplication at compile
                 scope via the SAME Ignite/Calcite/Avatica chain, so pairing httpcore5 at the same (default,
                 compile) scope is the consistent fix, not a widening beyond what was already effectively on that
                 classpath. -->
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <!-- Tier-2 browser round-trip driver (plan-74 Cliff C5, Slice 0/4 pilot). -->
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.44.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- plan-154 AC-R3: UnbufferedUploadTransportEndToEndTest/UnbufferedUploadTransportGlobalCeilingTest
                     redirect java.io.tmpdir to a fresh, empty directory so their in-process temp-tree sampler can
                     watch it cheaply (a walk of the real system temp is infeasible - measured 3.3-3.6s per round).
                     This MUST be a JVM launch argument, not a runtime System.setProperty in the test itself: the
                     JDK's temp-file helpers (both java.io.File and java.nio.file.Files) cache java.io.tmpdir in a
                     static field on FIRST USE within the JVM, and Surefire reuses one JVM across every test class
                     in this module by default (forkCount=1, reuseForks=true) - so a class-local override could
                     silently lose the race against whatever earlier class already touched a temp file. Harmless to
                     every other test in this module: it only relocates where temp files land, under target/, which
                     `mvn clean` already owns. -->
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.io.tmpdir=${project.build.directory}/surefire-java-io-tmpdir</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Binds *IT classes (ToggleButtonRoundTripIT) to integration-test/verify so
                     `mvn verify` runs them, gated by the same ${excludedGroups} property as
                     surefire above. Default `mvn test` never reaches this plugin's bound phases. -->
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>